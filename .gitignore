.idea/
*.swp
*.swo

# Build artifacts
*.exe
*.dll
*.so
*.lnk

# Portable build — staging tree and release zip
portable/
*.zip

# Logs & temp
*.log
*.tmp
*.bak

# git-auto-gui project settings
.git-auto-gui.json
qigor_wallpaper_manager_150k.jpg
qigor_wallpaper_manager_thumb.jpg

# Build outputs — regenerated by build.pyw, uploaded as release assets
/version.json
/SHA256.txt
/QiGor-Setup.cmd

# A separate, private tool that happens to live in this folder. It is its own
# git repository, so it must be ignored here: without this, `git add -A` files
# it as a gitlink and commits a broken submodule pointer to a public repo.
/qigor_wallpaper_sync/
